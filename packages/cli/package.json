{
	"name": "firewake",
	"description": "A modular CLI for declarative project configuration, code generation, and development workflows.",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"author": "firewake",
	"license": "MIT",
	"repository": "firewake/firewake",
	"homepage": "https://github.com/firewake/firewake",
	"bugs": "https://github.com/firewake/firewake/issues",
	"bin": {
		"firewake": "./bin/run.js"
	},
	"files": [
		"./bin",
		"./dist"
	],
	"engines": {
		"node": ">=24.11.0 <25"
	},
	"dependencies": {
		"@firewake/core": "workspace:*",
		"@oclif/core": "^4",
		"@oclif/plugin-help": "^6"
	},
	"devDependencies": {
		"@types/node": "^24",
		"oclif": "^4",
		"shx": "^0.3.3",
		"ts-node": "^10",
		"typescript": "^7"
	},
	"oclif": {
		"bin": "firewake",
		"dirname": "firewake",
		"commands": "./dist/commands",
		"plugins": [
			"@oclif/plugin-help"
		],
		"topicSeparator": " "
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -b",
		"typecheck": "tsc --noEmit"
	}
}
